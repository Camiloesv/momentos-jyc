momentos.jesycami.bond {
    encode zstd gzip

    handle_path /uploads/* {
        root * /var/www/momentos/uploads
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    handle {
        reverse_proxy localhost:3001
    }

    log {
        output file /var/log/caddy/momentos.log
        format console
    }
}
